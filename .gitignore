# Virtual Environments
.venv/
venv/
env/

# Python Cache & Testing
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Node & Frontend Dependencies (dist is kept so users don't need Node.js)
frontend/node_modules/
frontend/.vite/

# User data, transaction logs, databases and generated reports
data/**/*.db
data/**/*.sqlite
data/**/*.sqlite3
artifacts/*
!artifacts/.gitkeep
!data/.gitkeep

# Local secrets and configuration
.env
.env.*
!.env.example
*.pem
*.key
*.sqlite
*.sqlite3

# System & IDE Configs
.DS_Store
.idea/
.vscode/
*.log


# Local daemon lease and process ownership
.runtime/

# Local agent notes
/.superpowers/
/docs/superpowers/
